rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      let role = getUserData().role;
      return isSignedIn() && (role == 'admin' || role == 'superadmin' || request.auth.token.email == 'manager@test.es' || request.auth.token.email == 'superadmin@test.es');
    }
    
    function isCompany() {
      return isSignedIn() && getUserData().role == 'company';
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() 
                   || (isSignedIn() && request.auth.uid == userId)
                   || (isCompany() && resource.data.companyId == request.auth.uid);
    }

    // Routes collection
    match /routes/{routeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.driverId == request.auth.uid;
      allow update, delete: if isAdmin() 
                            || (isSignedIn() && resource.data.driverId == request.auth.uid)
                            || (isCompany() && resource.data.companyId == request.auth.uid);
    }

    // Emergencies collection
    match /emergencies/{emergencyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isCompany() && resource.data.companyId == request.auth.uid);
    }

    // Locations collection
    match /locations/{locationId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}