rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isSignedIn() && (getUserData().role == 'admin' || request.auth.token.email == 'manager@test.es');
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // Routes collection
    match /routes/{routeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.driverId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.driverId == request.auth.uid);
    }

    // Emergencies collection
    match /emergencies/{emergencyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin();
    }

    // Locations collection
    match /locations/{locationId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}